{
  "name": "@wendoo/ecosim",
  "description": "Ecosystem Simulation App for Wendoo",
  "version": "1.2.20",
  "private": true,
  "type": "module",
  "author": "wendoo-lang",
  "license": "MIT",
  "keywords": [
    "phaser",
    "react",
    "vite",
    "typescript",
    "kode",
    "kodu",
    "project-spark",
    "sklanch",
    "sandbox",
    "simulation",
    "creative-coding",
    "game-development",
    "stem",
    "education",
    "learning",
    "coding",
    "programming",
    "games",
    "game-maker"
  ],
  "scripts": {
    "predev": "npm run build:deps",
    "dev": "vite --config vite/config.dev.mjs --force",
    "prebuild": "npm run build:deps",
    "build": "vite build --config vite/config.prod.mjs",
    "postbuild": "npm run build:headless",
    "build:headless": "wireit",
    "package": "npm run build && node_modules/.bin/wendoo assemble",
    "release-trg": "node_modules/.bin/wendoo release",
    "pregenerate:ambient": "npm run generate:ambient --prefix ../../packages/core",
    "generate:ambient": "tsx --tsconfig scripts/tsconfig.json scripts/generate-ambient.ts",
    "clean": "rm -rf dist && rm -rf dist-headless && rm -rf node_modules/.vite",
    "lint:only": "biome lint ./src ./vite",
    "check:only": "biome check ./src ./vite",
    "format:only": "biome format ./src ./vite",
    "lint": "biome lint ./src ./vite --write",
    "check": "biome check ./src ./vite --write",
    "pretest": "npm run build:deps && npm run build:headless",
    "test": "npm run check:partition && tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')",
    "check:partition": "node ../../scripts/tsconfig-partition.js .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p src/rehearsal/tsconfig.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p lib/tsconfig.ambient.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p lib/tsconfig.json && tsc --noEmit -p extensions/tsconfig.json",
    "format": "biome format ./src ./vite --write",
    "build:deps": "node ../../scripts/build-packages.js .",
    "release": "node scripts/release-dispatch.mjs"
  },
  "wendooTarget": {
    "packageScript": "package",
    "hostApp": {
      "path": "dist",
      "script": "build"
    },
    "rehearsalAdapter": {
      "path": "dist-headless/rehearsal/adapter.js",
      "script": "build:headless"
    }
  },
  "wireit": {
    "build:headless": {
      "command": "vite build --config vite/config.headless.mjs",
      "files": [
        "src/**",
        "vite/**",
        "tsconfig*.json",
        "package.json",
        "wendoo.json",
        "../../packages/core/package.json",
        "../../packages/core/dist/node/**",
        "../../packages/core/dist/esm/**",
        "../../packages/service-api/package.json",
        "../../packages/service-api/dist/**",
        "../../packages/app-host/package.json",
        "../../packages/app-host/dist/**",
        "../../packages/assistant-relay/package.json",
        "../../packages/assistant-relay/dist/**",
        "../../packages/assistant-bridge/package.json",
        "../../packages/assistant-bridge/dist/**",
        "../../packages/ui/package.json",
        "../../packages/ui/src/**",
        "../../packages/assistant-panel/package.json",
        "../../packages/assistant-panel/src/**",
        "../../packages/bridge-protocol/package.json",
        "../../packages/bridge-protocol/dist/**",
        "../../packages/bridge-client/package.json",
        "../../packages/bridge-client/dist/**",
        "../../packages/ts-compiler/package.json",
        "../../packages/ts-compiler/dist/**",
        "../../packages/bridge-app/package.json",
        "../../packages/bridge-app/dist/**",
        "../../packages/docs/package.json",
        "../../packages/docs/src/**",
        "../../packages/cli/package.json",
        "../../packages/cli/dist/**"
      ],
      "output": [
        "dist-headless/**"
      ]
    }
  },
  "dependencies": {
    "@wendoo/app-host": "file:../../packages/app-host",
    "@wendoo/assistant-bridge": "file:../../packages/assistant-bridge",
    "@wendoo/assistant-panel": "file:../../packages/assistant-panel",
    "@wendoo/assistant-relay": "file:../../packages/assistant-relay",
    "@wendoo/bridge-app": "file:../../packages/bridge-app",
    "@wendoo/core": "file:../../packages/core",
    "@wendoo/docs": "file:../../packages/docs",
    "@wendoo/ts-compiler": "file:../../packages/ts-compiler",
    "@wendoo/ui": "file:../../packages/ui",
    "lucide-react": "^0.561.0",
    "miniplex": "^2.0.0",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "terser": "^5.28.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "wendoo": "file:../../packages/cli",
    "wireit": "^0.14.13"
  }
}
