{
  "name": "wendoo-lang",
  "description": "Wendoo -- a tile-based programming language for creative coding applications",
  "private": true,
  "license": "MIT",
  "scripts": {
    "install": "npm run install:packages && npm run install:apps",
    "install:packages": "npm --prefix packages install",
    "install:apps": "npm --prefix apps install",
    "lockfiles:check": "node scripts/lockfiles.js --fix-command 'npm run lockfiles:sync' .",
    "lockfiles:sync": "node scripts/lockfiles.js --fix .",
    "build-inputs:check": "node scripts/build-inputs.js --fix-command 'npm run build-inputs:sync' .",
    "build-inputs:sync": "node scripts/build-inputs.js --fix .",
    "check": "biome check --write ./scripts",
    "check:only": "biome check ./scripts",
    "test": "node --test scripts/*.spec.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^25.0.2",
    "chalk": "^5.6.2",
    "tsx": "^4.21.0"
  }
}
