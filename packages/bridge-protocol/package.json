{
  "name": "@wendoo/bridge-protocol",
  "version": "0.2.12",
  "description": "WebSocket protocol types and schemas for the Wendoo VS Code Bridge",
  "license": "MIT",
  "type": "module",
  "author": "wendoo-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendoo-lang/wendoo-lang.git",
    "directory": "packages/bridge-protocol"
  },
  "bugs": {
    "url": "https://github.com/wendoo-lang/wendoo-lang/issues"
  },
  "homepage": "https://github.com/wendoo-lang/wendoo-lang/tree/main/packages/bridge-protocol#readme",
  "keywords": [
    "wendoo",
    "visual-programming",
    "tile-based",
    "typescript",
    "vscode",
    "language",
    "education",
    "stem",
    "coding",
    "game-development",
    "creative-coding",
    "kodu",
    "project-spark"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "wendooBuild": {
    "script": "build:prod",
    "outputs": [
      "dist"
    ],
    "postProcessed": false
  },
  "scripts": {
    "build": "tsc --build",
    "build:prod": "wireit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.prod.tsbuildinfo",
    "watch": "tsc --build --watch",
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "typecheck": "tsc --noEmit",
    "format": "biome format ./src --write",
    "release:patch": "node ../../scripts/release.js patch",
    "release:minor": "node ../../scripts/release.js minor",
    "release:major": "node ../../scripts/release.js major"
  },
  "wireit": {
    "build:prod": {
      "command": "tsc --build tsconfig.prod.json",
      "files": [
        "src/**",
        "!src/**/*.spec.ts",
        "tsconfig.json",
        "tsconfig.prod.json",
        "package-lock.json"
      ],
      "output": [
        "dist/**",
        "tsconfig.prod.tsbuildinfo"
      ],
      "clean": true,
      "packageLocks": []
    }
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "typescript": "~5.9.3",
    "wireit": "^0.14.13"
  }
}
