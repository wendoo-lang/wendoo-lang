{
  "name": "@wendoo/docs",
  "description": "Shared documentation sidebar and rendering components for Wendoo apps",
  "version": "0.2.0",
  "type": "module",
  "author": "wendoo-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendoo-lang/wendoo-lang.git",
    "directory": "packages/docs"
  },
  "bugs": {
    "url": "https://github.com/wendoo-lang/wendoo-lang/issues"
  },
  "homepage": "https://github.com/wendoo-lang/wendoo-lang/tree/main/packages/docs#readme",
  "keywords": [
    "wendoo",
    "visual-programming",
    "tile-based",
    "documentation",
    "react",
    "docs",
    "markdown",
    "education",
    "stem",
    "coding",
    "creative-coding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts' -o -name '*.spec.tsx')",
    "format": "biome format ./src --write",
    "release:patch": "node ../../scripts/release.js patch",
    "release:minor": "node ../../scripts/release.js minor",
    "release:major": "node ../../scripts/release.js major"
  },
  "dependencies": {
    "@wendoo/core": "file:../core",
    "@wendoo/ui": "file:../ui",
    "lucide-react": "^0.561.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
