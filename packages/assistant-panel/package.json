{
  "name": "@wendoo/assistant-panel",
  "description": "Assistant conversation provider: relay session lifecycle, per-brain conversation records, and client-side tool serving",
  "version": "0.1.0",
  "type": "module",
  "author": "wendoo-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendoo-lang/wendoo-lang.git",
    "directory": "packages/assistant-panel"
  },
  "bugs": {
    "url": "https://github.com/wendoo-lang/wendoo-lang/issues"
  },
  "homepage": "https://github.com/wendoo-lang/wendoo-lang/tree/main/packages/assistant-panel#readme",
  "keywords": [
    "wendoo",
    "assistant",
    "visual-programming",
    "tile-based",
    "react",
    "components",
    "education",
    "stem",
    "coding",
    "creative-coding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "test": "tsx --disable-warning=ExperimentalWarning --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts' -o -name '*.spec.tsx')",
    "format": "biome format ./src --write",
    "release:patch": "node ../../scripts/release.js patch",
    "release:minor": "node ../../scripts/release.js minor",
    "release:major": "node ../../scripts/release.js major"
  },
  "dependencies": {
    "@wendoo/assistant-bridge": "file:../assistant-bridge",
    "@wendoo/assistant-relay": "file:../assistant-relay",
    "@wendoo/core": "file:../core",
    "@wendoo/ui": "file:../ui"
  },
  "peerDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "ws": "^8.21.3"
  }
}
