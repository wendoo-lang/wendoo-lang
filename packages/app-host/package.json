{
  "name": "@wendoo/app-host",
  "version": "0.2.9",
  "description": "Project management and project file storage for Wendoo apps",
  "license": "MIT",
  "type": "module",
  "author": "wendoo-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendoo-lang/wendoo-lang.git",
    "directory": "packages/app-host"
  },
  "bugs": {
    "url": "https://github.com/wendoo-lang/wendoo-lang/issues"
  },
  "homepage": "https://github.com/wendoo-lang/wendoo-lang/tree/main/packages/app-host#readme",
  "keywords": [
    "wendoo",
    "visual-programming",
    "tile-based",
    "typescript",
    "language",
    "education",
    "stem",
    "coding",
    "game-development",
    "creative-coding",
    "kodu",
    "project-spark"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "wendooBuild": {
    "script": "build:prod",
    "outputs": [
      "dist"
    ],
    "postProcessed": false
  },
  "scripts": {
    "build": "tsc --build",
    "build:prod": "tsc --build tsconfig.prod.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.prod.tsbuildinfo",
    "watch": "tsc --build --watch",
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "pretest": "npm run build:prod",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')",
    "format": "biome format ./src --write",
    "release:patch": "node ../../scripts/release.js patch",
    "release:minor": "node ../../scripts/release.js minor",
    "release:major": "node ../../scripts/release.js major"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@wendoo/core": "file:../core",
    "@wendoo/service-api": "file:../service-api",
    "idb": "^8.0.3"
  }
}
