{
  "name": "@wendoo/ts-compiler",
  "version": "0.2.3",
  "description": "TypeScript-to-Wendoo bytecode compiler for sensors and actuators implemented in TypeScript",
  "license": "MIT",
  "type": "module",
  "author": "wendoo-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendoo-lang/wendoo-lang.git",
    "directory": "packages/ts-compiler"
  },
  "bugs": {
    "url": "https://github.com/wendoo-lang/wendoo-lang/issues"
  },
  "homepage": "https://github.com/wendoo-lang/wendoo-lang/tree/main/packages/ts-compiler#readme",
  "keywords": [
    "wendoo",
    "visual-programming",
    "tile-based",
    "typescript",
    "language",
    "education",
    "stem",
    "coding",
    "game-development",
    "creative-coding",
    "kodu",
    "project-spark"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "browser": "./dist/testing/index.js",
      "import": "./dist/testing/index.js"
    }
  },
  "wendooBuild": {
    "script": "build:prod",
    "outputs": [
      "dist"
    ],
    "postProcessed": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:prod": "wireit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.prod.tsbuildinfo",
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "format": "biome format ./src --write",
    "pretest": "npm run build:prod",
    "test": "SINK=$(mktemp); DIAG_COVERAGE_SINK=\"$SINK\" tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts') && DIAG_COVERAGE_SINK=\"$SINK\" tsx --tsconfig tsconfig.spec.json src/testsupport/diag-coverage-check.ts",
    "release:patch": "node ../../scripts/release.js patch",
    "release:minor": "node ../../scripts/release.js minor",
    "release:major": "node ../../scripts/release.js major"
  },
  "wireit": {
    "build:prod": {
      "command": "tsc --build tsconfig.prod.json",
      "dependencies": [
        "../core:build:prod",
        "../service-api:build:prod"
      ],
      "files": [
        "src/**",
        "!src/**/*.spec.ts",
        "!src/testsupport/**",
        "tsconfig.json",
        "tsconfig.prod.json",
        "package-lock.json"
      ],
      "output": [
        "dist/**",
        "tsconfig.prod.tsbuildinfo"
      ],
      "clean": true,
      "packageLocks": []
    }
  },
  "dependencies": {
    "@wendoo/core": "file:../core",
    "@wendoo/service-api": "file:../service-api",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "wireit": "^0.14.13"
  }
}
