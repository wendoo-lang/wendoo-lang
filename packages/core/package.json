  "files": [
    "dist",
    "lib",
    "README.md"
  ],
  "wendooBuild": {
    "script": "build:prod",
    "outputs": [
      "dist/node",
      "dist/esm"
    ],
    "postProcessed": true,
    "variants": {
      "rbx": {
        "script": "build:rbx",
        "outputs": [
          "dist/rbx"
        ]
      }
    }
  },
  "scripts": {
    "build": "npm run build:docs && npm run build:rbx && npm run build:node && npm run build:esm",
    "build:prod": "wireit",
    "build:docs": "node scripts/build-docs.js",
    "build:node": "tsc -p tsconfig.node.json && node scripts/post-build-node.js",
    "build:esm": "tsc --build tsconfig.esm.json && node scripts/post-build-esm.js",
    "build:rbx": "wireit",
    "pregenerate:ambient": "npm run build:node && npm run build:prod --prefix ../ts-compiler",
    "generate:ambient": "tsx --tsconfig scripts/tsconfig.json scripts/generate-ambient.ts",
    "pregenerate:localization": "npm run build:node",
    "generate:localization": "tsx --tsconfig scripts/tsconfig.json scripts/generate-localization.ts",
    "watch:rbx": "node scripts/watch-rbx.js",
    "clean": "rm -rf dist tsconfig.esm.tsbuildinfo .platform-emit",
    "lint:only": "biome lint ./src ./scripts",
    "check:only": "biome check ./src ./scripts",
    "format:only": "biome format ./src ./scripts",
    "lint": "biome lint ./src ./scripts --write",
    "check": "biome check ./src ./scripts --write",
    "check:call-style": "node scripts/check-call-style.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.rbx.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p lib/tsconfig.ambient.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p lib/tsconfig.json",
    "format": "biome format ./src ./scripts --write",
    "pretest": "npm run build:node && npm run build:esm && npm run build:rbx",
    "test": "npm run check:call-style && tsx --tsconfig tsconfig.node.json --test $(find src -name '*.spec.ts')",
    "release:patch": "node ../../scripts/release.js patch",
    "release:minor": "node ../../scripts/release.js minor",
    "release:major": "node ../../scripts/release.js major"
  },
  "wireit": {
    "build:prod": {
      "command": "npm run build:docs && npm run build:node && npm run build:esm",
      "files": [
        "src/**",
        "!src/**/*.spec.ts",
        "!src/**/*.rbx.ts",
        "!src/**/__fixtures__/**",
        "scripts/build-docs.js",
        "scripts/build-utils.js",
        "scripts/post-build-esm.js",
        "scripts/post-build-node.js",
        "tsconfig.node.json",
        "tsconfig.esm.json",
        "package-lock.json"
      ],
      "output": [
        "dist/node/**",
        "dist/esm/**",
        ".platform-emit/node/**",
        ".platform-emit/esm/**",
        "tsconfig.esm.tsbuildinfo"
      ],
      "clean": true,
      "packageLocks": []
    },
    "build:rbx": {
      "command": "rbxtsc --type package --project tsconfig.rbx.json && node scripts/post-build-rbx.js",
      "files": [
        "src/**",
        "!src/**/*.node.ts",
        "!src/**/*.spec.ts",
        "!src/**/__fixtures__/**/*.ts",
        "!src/docs/**/*.ts",
        "scripts/post-build-rbx.js",
        "scripts/build-utils.js",
        "tsconfig.rbx.json",
        "default.project.json",
        "package-lock.json"
      ],
      "output": [
        "dist/rbx/**",
        ".platform-emit/rbx/**"
      ],
      "clean": true,
      "packageLocks": []
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@rbxts/compiler-types": "^3.0.0-types.0",
    "@rbxts/types": "^1.0.896",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "chalk": "^4.1.2",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-roblox-ts": "^1.3.1",
    "roblox-ts": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "wireit": "^0.14.13"
  }
}
