{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.esm.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./dist/esm",
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "types": [],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "preserveSymlinks": true
  },
  "include": ["src"],
  "exclude": ["src/tooling/**", "**/*.rbx.ts", "**/*.spec.ts", "**/__fixtures__/**", "dist/**", "out/**"]
}
