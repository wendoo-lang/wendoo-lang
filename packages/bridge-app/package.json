{
  "name": "@wendoo/bridge-app",
  "version": "0.2.2",
  "description": "App-side client for the Wendoo bridge",
  "license": "MIT",
  "type": "module",
  "author": "wendoo-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendoo-lang/wendoo-lang.git",
    "directory": "packages/bridge-app"
  },
  "bugs": {
    "url": "https://github.com/wendoo-lang/wendoo-lang/issues"
  },
  "homepage": "https://github.com/wendoo-lang/wendoo-lang/tree/main/packages/bridge-app#readme",
  "keywords": [
    "wendoo",
    "visual-programming",
    "tile-based",
    "typescript",
    "vscode",
    "language",
    "education",
    "stem",
    "coding",
    "game-development",
    "creative-coding",
    "kodu",
    "project-spark"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./compilation": {
      "types": "./dist/compilation.d.ts",
      "browser": "./dist/compilation.js",
      "import": "./dist/compilation.js"
    },
    "./manifest-files": {
      "types": "./dist/manifest-files.d.ts",
      "browser": "./dist/manifest-files.js",
      "import": "./dist/manifest-files.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "wendooBuild": {
    "script": "build:prod",
    "outputs": [
      "dist"
    ],
    "postProcessed": false
  },
  "scripts": {
    "build": "tsc --build",
    "build:prod": "wireit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.prod.tsbuildinfo",
    "watch": "tsc --build --watch",
    "lint:only": "biome lint ./src",
    "check:only": "biome check ./src",
    "format:only": "biome format ./src",
    "lint": "biome lint ./src --write",
    "check": "biome check ./src --write",
    "pretest": "npm run build:prod",
    "test": "tsx --tsconfig tsconfig.spec.json --test $(find src -name '*.spec.ts')",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "format": "biome format ./src --write",
    "release:patch": "node ../../scripts/release.js patch",
    "release:minor": "node ../../scripts/release.js minor",
    "release:major": "node ../../scripts/release.js major"
  },
  "wireit": {
    "build:prod": {
      "command": "tsc --build tsconfig.prod.json",
      "dependencies": [
        "../app-host:build:prod",
        "../bridge-client:build:prod",
        "../bridge-protocol:build:prod",
        "../core:build:prod",
        "../ts-compiler:build:prod"
      ],
      "files": [
        "src/**",
        "!src/**/*.spec.ts",
        "tsconfig.json",
        "tsconfig.prod.json",
        "package-lock.json"
      ],
      "output": [
        "dist/**",
        "tsconfig.prod.tsbuildinfo"
      ],
      "clean": true,
      "packageLocks": []
    }
  },
  "dependencies": {
    "@wendoo/app-host": "file:../app-host",
    "@wendoo/bridge-client": "file:../bridge-client",
    "@wendoo/bridge-protocol": "file:../bridge-protocol",
    "@wendoo/core": "file:../core",
    "@wendoo/ts-compiler": "file:../ts-compiler"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "wireit": "^0.14.13"
  }
}
